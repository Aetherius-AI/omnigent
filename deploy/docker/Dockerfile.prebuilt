# Pulls the CI-built server image instead of building from source — the web UI
# bundle is gitignored, so a plain `docker build` would fail. For platforms that
# only run `docker build` (Railway, HF Spaces). Override the tag via
# --build-arg OMNIGENT_IMAGE=ghcr.io/omnigent-ai/omnigent-server:vX.Y.Z.

ARG OMNIGENT_IMAGE=ghcr.io/omnigent-ai/omnigent-server:latest
FROM ${OMNIGENT_IMAGE}

# Render the Railway server config from its template so the public URL is
# supplied by the OMNIGENT_SERVER_URL build arg rather than committed. When the
# arg is empty no config is written and the server falls back to env settings.
ARG OMNIGENT_SERVER_URL=
COPY deploy/railway/config.yaml /tmp/railway-config.yaml
RUN if [ -n "${OMNIGENT_SERVER_URL}" ]; then \
        mkdir -p /etc/omnigent \
        && sed "s|__OMNIGENT_SERVER_URL__|${OMNIGENT_SERVER_URL}|" /tmp/railway-config.yaml \
           > /etc/omnigent/config.yaml; \
    fi \
    && rm -f /tmp/railway-config.yaml
